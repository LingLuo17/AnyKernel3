# ZRAM 压缩算法配置片段
# 由 build.yml 工作流在启用 use_zram 时追加到 defconfig
# CRYPTO_* 为 5.10~6.6 的 crypto 接口 zram 所需；
# ZRAM_BACKEND_* 为 6.12 新架构 zram（backend_* 直连实现）所需，
# 旧版本内核未定义这些符号时会被 olddefconfig 静默忽略
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_LZ4K=y
CONFIG_CRYPTO_LZ4KD=y
CONFIG_CRYPTO_842=y
CONFIG_CRYPTO_LZ4K_OPLUS=y
CONFIG_ZRAM_BACKEND_LZ4K=y
CONFIG_ZRAM_BACKEND_LZ4KD=y
CONFIG_ZRAM_BACKEND_LZ4K_OPLUS=y
