gki-android15-6.6=84c8fd6929c0f9a0cdd78f707599b6d76f415d37
gki-android16-6.12=ed4f1b7dc57aed37ccd0e37e6fe28b9a05bb40ea

# ==================== SukiSU 的 commit hash ====================
# 仅当 custom=true 且使用 SukiSU 变体时生效
